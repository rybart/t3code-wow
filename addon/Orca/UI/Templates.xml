<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\Blizzard_SharedXML\UI.xsd">
	<!-- The message box: Enter sends (or takes the highlighted suggestion), Shift+Enter adds a line (handled in MainFrame.lua). -->
	<Frame name="OrcaComposerTemplate" inherits="ScrollingEditBoxTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="useDefaultEnterHandling" value="false" type="boolean"/>
			<KeyValue key="maxLetters" value="2000" type="number"/>
			<KeyValue key="fontName" value="ChatFontNormal" type="string"/>
		</KeyValues>
	</Frame>

	<!-- One template per kind of list row: ScrollBox recycles rows per template, so
	     sharing a plain "Frame" between kinds would leave one kind's text on another. -->
	<Frame name="OrcaMessageRowTemplate" virtual="true"/>
	<Frame name="OrcaNoteRowTemplate" virtual="true"/>
	<Button name="OrcaOptionRowTemplate" virtual="true"/>
	<Button name="OrcaThreadRowTemplate" virtual="true"/>
	<Button name="OrcaGroupHeaderTemplate" virtual="true"/>
	<Frame name="OrcaEmptyRowTemplate" virtual="true"/>
	<Button name="OrcaDropdownRowTemplate" virtual="true"/>
</Ui>
